DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce
AUTH_SECRET=dev-secret-change-me-at-least-32-characters
PORT=8080
# Public origin the browser talks to (the app). Better Auth trusts this origin.
BASE_URL=http://localhost:5173
# Image storage: leave unset for local disk (api/storage/media).
