# MinIO: STORAGE_URL=s3+http://minioadmin:minioadmin@localhost:9000/commerce-media
# Public <img> base (CDN). Defaults to endpoint/bucket.
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
